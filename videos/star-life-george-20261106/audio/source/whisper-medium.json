": [[228.42, 228.52, " So"], [228.52, 228.78, " that's"], [228.78, 228.9, " the"], [228.9, 229.1, " whole"], [229.1, 229.54, " journey."], [230.32, 230.48, " A"], [230.48, 230.8, " cold"], [230.8, 231.22, " cloud"], [231.22, 231.8, " collapses."]]}, {"s": 232.54, "e": 235.86, "t": " A protostar ignites. For millions of years", "words": [[232.54, 232.72, " A"], [232.72, 233.34, " protostar"], [233.34, 233.98, " ignites."], [234.78, 235.02, " For"], [235.02, 235.28, " millions"], [235.28, 235.56, " of"], [235.56, 235.86, " years"]]}, {"s": 235.86, "e": 239.52, "t": " pressure holds gravity back. Then the core falls", "words": [[235.86, 236.38, " pressure"], [236.38, 236.8, " holds"], [236.8, 237.24, " gravity"], [237.24, 237.68, " back."], [238.42, 238.6, " Then"], [238.6, 238.78, " the"], [238.78, 239.0, " core"], [239.0, 239.52, " falls"]]}, {"s": 239.52, "e": 244.66, "t": " and what's left can disappear into the dark. But the gas the star threw away", "words": [[239.52, 240.02, " and"], [240.02, 240.28, " what's"], [240.28, 240.5, " left"], [240.5, 240.76, " can"], [240.76, 241.18, " disappear"], [241.18, 241.48, " into"], [241.48, 241.7, " the"], [241.7, 242.06, " dark."], [242.72, 243.0, " But"], [243.0, 243.18, " the"], [243.18, 243.4, " gas"], [243.4, 243.6, " the"], [243.6, 243.94, " star"], [243.94, 244.2, " threw"], [244.2, 244.66, " away"]]}, {"s": 245.22, "e": 247.26, "t": " it's already becoming the next cloud.", "words": [[245.22, 245.6, " it's"], [245.6, 245.9, " already"], [245.9, 246.3, " becoming"], [246.3, 246.5, " the"], [246.5, 246.74, " next"], [246.74, 247.26, " cloud."]]}]