[{"s": 0.0, "e": 4.12, "t": " How does a soft cloud of dust become the darkest object in the universe?", "words": [[0.0, 0.24, " How"], [0.24, 0.42, " does"], [0.42, 0.6, " a"], [0.6, 0.94, " soft"], [0.94, 1.26, " cloud"], [1.26, 1.48, " of"], [1.48, 1.84, " dust"], [1.84, 2.32, " become"], [2.32, 2.58, " the"], [2.58, 2.94, " darkest"], [2.94, 3.4, " object"], [3.4, 3.62, " in"], [3.62, 3.8, " the"], [3.8, 4.12, " universe?"]]}, {"s": 5.3, "e": 8.04, "t": " Stay with me because the answer is a tug of war.", "words": [[5.3, 5.46, " Stay"], [5.46, 5.66, " with"], [5.66, 5.98, " me"], [5.98, 6.42, " because"], [6.42, 6.64, " the"], [6.64, 6.92, " answer"], [6.92, 7.14, " is"], [7.14, 7.36, " a"], [7.36, 7.5, " tug"], [7.5, 7.74, " of"], [7.74, 8.04, " war."]]}, {"s": 8.9, "e": 11.58, "t": " And the calcium in your bones is part of the story.", "words": [[8.9, 8.94, " And"], [8.94, 9.12, " the"], [9.12, 9.44, " calcium"], [9.44, 9.64, " in"], [9.64, 9.86, " your"], [9.86, 10.26, " bones"], [10.26, 10.64, " is"], [10.64, 10.88, " part"], [10.88, 11.04, " of"], [11.04, 11.18, " the"], [11.18, 11.58, " story."]]}, {"s": 12.66, "e": 18.72, "t": " It starts in a molecular cloud. Cold gas with up to 10 million times the mass of the sun", "words": [[12.66, 12.82, " It"], [12.82, 13.2, " starts"], [13.2, 13.38, " in"], [13.38, 13.52, " a"], [13.52, 13.88, " molecular"], [13.88, 14.46, " cloud."], [15.32, 15.6, " Cold"], [15.6, 16.06, " gas"], [16.06, 16.38, " with"], [16.38, 16.5, " up"], [16.5, 16.74, " to"], [16.74, 16.92, " 10"], [16.92, 17.22, " million"], [17.22, 17.72, " times"], [17.72, 17.92, " the"], [17.92, 18.1, " mass"], [18.1, 18.28, " of"], [18.28, 18.52, " the"], [18.52, 18.72, " sun"]]}, {"s": 18.72, "e": 24.48, "t": " stretched across hundreds of light years. Some clumps gather more matter and their", "words": [[18.72, 19.5, " stretched"], [19.5, 19.96, " across"], [19.96, 20.36, " hundreds"], [20.36, 20.68, " of"], [20.68, 20.86, " light"], [20.86, 21.28, " years."], [22.32, 22.52, " Some"], [22.52, 22.94, " clumps"], [22.94, 23.24, " gather"], [23.24, 23.54, " more"], [23.54, 23.92, " matter"], [23.92, 24.42, " and"], [24.42, 24.72, " their"]]}, {"s": 24.72, "e": 28.86, "t": " gravity grows stronger. One collapses and heats up.", "words": [[24.72, 24.96, " gravity"], [24.96, 25.24, " grows"], [25.24, 25.8, " stronger."], [26.8, 27.06, " One"], [27.06, 27.62, " collapses"], [27.62, 28.02, " and"], [28.02, 28.26, " heats"], [28.26, 28.86, " up."]]}, {"s": 29.36, "e": 32.74, "t": " That's a protostar. It isn't burning anything yet.", "words": [[29.36, 29.72, " That's"], [29.72, 29.88, " a"], [29.88, 30.56, " protostar."], [31.06, 31.42, " It"], [31.42, 31.7, " isn't"], [31.7, 31.98, " burning"], [31.98, 32.34, " anything"], [32.34, 32.74, " yet."]]}, {"s": 33.12, "e": 37.2, "t": " It keeps gaining mass. Its core gets hotter and denser.", "words": [[33.12, 33.36, " It"], [33.36, 33.64, " keeps"], [33.64, 34.0, " gaining"], [34.0, 34.5, " mass."], [35.2, 35.42, " Its"], [35.42, 35.7, " core"], [35.7, 35.98, " gets"], [35.98, 36.3, " hotter"], [36.3, 36.58, " and"], [36.58, 37.2, " denser."]]}, {"s": 37.84, "e": 42.8, "t": " At about 15 million degrees hydrogen nuclei are squeezed together so hard", "words": [[37.84, 37.98, " At"], [37.98, 38.24, " about"], [38.24, 38.7, " 15"], [38.7, 39.04, " million"], [39.04, 39.62, " degrees"], [39.62, 40.42, " hydrogen"], [40.42, 41.1, " nuclei"], [41.1, 41.32, " are"], [41.32, 41.62, " squeezed"], [41.62, 42.04, " together"], [42.04, 42.36, " so"], [42.36, 42.8, " hard"]]}, {"s": 42.8, "e": 46.36, "t": " that they fuse into helium. That's nuclear fusion.", "words": [[42.8, 43.16, " that"], [43.16, 43.36, " they"], [43.36, 43.58, " fuse"], [43.58, 43.9, " into"], [43.9, 44.32, " helium."], [44.96, 45.58, " That's"], [45.58, 45.88, " nuclear"], [45.88, 46.36, " fusion."]]}, {"s": 47.04, "e": 52.36, "t": " And in that moment a star is born. Now gravity pulls in and the heat from", "words": [[47.04, 47.18, " And"], [47.18, 47.32, " in"], [47.32, 47.5, " that"], [47.5, 47.86, " moment"], [47.86, 48.24, " a"], [48.24, 48.52, " star"], [48.52, 48.78, " is"], [48.78, 49.12, " born."], [50.06, 50.28, " Now"], [50.28, 50.72, " gravity"], [50.72, 51.1, " pulls"], [51.1, 51.4, " in"], [51.4, 51.76, " and"], [51.76, 51.94, " the"], [51.94, 52.14, " heat"], [52.14, 52.36, " from"]]}, {"s": 52.36, "e": 56.48, "t": " fusion pushes out. While they balance the star is stable.", "words": [[52.36, 52.7, " fusion"], [52.7, 53.08, " pushes"], [53.08, 53.54, " out."], [54.28, 54.5, " While"], [54.5, 54.72, " they"], [54.72, 55.1, " balance"], [55.1, 55.52, " the"], [55.52, 55.78, " star"], [55.78, 56.02, " is"], [56.02, 56.48, " stable."]]}, {"s": 57.38, "e": 62.76, "t": " Astronomers call this the main sequence. Our sun is roughly halfway through it.", "words": [[57.38, 57.88, " Astronomers"], [57.88, 58.12, " call"], [58.12, 58.34, " this"], [58.34, 58.56, " the"], [58.56, 58.82, " main"], [58.82, 59.42, " sequence."], [60.38, 60.6, " Our"], [60.6, 60.88, " sun"], [60.88, 61.12, " is"], [61.12, 61.44, " roughly"], [61.44, 61.84, " halfway"], [61.84, 62.24, " through"], [62.24, 62.76, " it."]]}, {"s": 63.22, "e": 66.28, "t": " So how long does it last? Mass decides.", "words": [[63.22, 63.4, " So"], [63.4, 63.58, " how"], [63.58, 63.78, " long"], [63.78, 63.94, " does"], [63.94, 64.1, " it"], [64.1, 64.56, " last?"], [65.44, 65.64, " Mass"], [65.64, 66.28, " decides."]]}, {"s": 67.22, "e": 71.52, "t": " A heavier star burns its fuel much faster just to hold up its own weight.", "words": [[67.22, 67.4, " A"], [67.4, 67.68, " heavier"], [67.68, 68.1, " star"], [68.1, 68.48, " burns"], [68.48, 68.7, " its"], [68.7, 68.98, " fuel"], [68.98, 69.26, " much"], [69.26, 69.78, " faster"], [69.78, 70.28, " just"], [70.28, 70.44, " to"], [70.44, 70.6, " hold"], [70.6, 70.78, " up"], [70.78, 70.94, " its"], [70.94, 71.14, " own"], [71.14, 71.52, " weight."]]}, {"s": 72.44, "e": 77.36, "t": " The sun gets about 10 billion years. Some massive stars only a few million.", "words": [[72.44, 72.62, " The"], [72.62, 72.84, " sun"], [72.84, 73.12, " gets"], [73.12, 73.44, " about"], [73.44, 73.72, " 10"], [73.72, 74.06, " billion"], [74.06, 74.6, " years."], [75.24, 75.48, " Some"], [75.48, 75.86, " massive"], [75.86, 76.32, " stars"], [76.32, 76.66, " only"], [76.66, 76.82, " a"], [76.82, 76.98, " few"], [76.98, 77.36, " million."]]}, {"s": 78.03999999999999, "e": 83.12, "t": " Mass also decides the ending. Stars like the sun fade quietly", "words": [[78.03999999999999, 78.6, " Mass"], [78.6, 79.1, " also"], [79.1, 79.6, " decides"], [79.6, 79.82, " the"], [79.82, 80.18, " ending."], [81.22, 81.48, " Stars"], [81.48, 81.7, " like"], [81.7, 81.96, " the"], [81.96, 82.18, " sun"], [82.18, 82.56, " fade"], [82.56, 83.12, " quietly"]]}, {"s": 83.12, "e": 86.76, "t": " into a white dwarf. A cooling cinder the size of Earth.", "words": [[83.12, 83.4, " into"], [83.4, 83.64, " a"], [83.64, 83.8, " white"], [83.8, 84.26, " dwarf."], [84.92, 85.06, " A"], [85.06, 85.36, " cooling"], [85.36, 85.76, " cinder"], [85.76, 85.98, " the"], [85.98, 86.22, " size"], [86.22, 86.46, " of"], [86.46, 86.76, " Earth."]]}, {"s": 87.74, "e": 91.82, "t": " Stars with more than about 8 times the sun's mass end by exploding.", "words": [[87.74, 88.08, " Stars"], [88.08, 88.26, " with"], [88.26, 88.5, " more"], [88.5, 88.68, " than"], [88.68, 88.92, " about"], [88.92, 89.2, " 8"], [89.2, 89.56, " times"], [89.56, 89.82, " the"], [89.82, 90.2, " sun's"], [90.2, 90.46, " mass"], [90.46, 90.98, " end"], [90.98, 91.24, " by"], [91.24, 91.82, " exploding."]]}, {"s": 92.88, "e": 97.24, "t": " And to leave a black hole a star probably needs around 20 suns or more.", "words": [[92.88, 93.02, " And"], [93.02, 93.16, " to"], [93.16, 93.3, " leave"], [93.3, 93.46, " a"], [93.46, 93.7, " black"], [93.7, 94.04, " hole"], [94.04, 94.5, " a"], [94.5, 94.78, " star"], [94.78, 95.22, " probably"], [95.22, 95.58, " needs"], [95.58, 95.9, " around"], [95.9, 96.28, " 20"], [96.28, 96.72, " suns"], [96.72, 96.9, " or"], [96.9, 97.24, " more."]]}, {"s": 98.2, "e": 102.6, "t": " Now follow one of the heavy ones. It swells into a red supergiant", "words": [[98.2, 98.5, " Now"], [98.5, 98.76, " follow"], [98.76, 98.96, " one"], [98.96, 99.1, " of"], [99.1, 99.26, " the"], [99.26, 99.44, " heavy"], [99.44, 99.88, " ones."], [100.6, 100.76, " It"], [100.76, 101.16, " swells"], [101.16, 101.42, " into"], [101.42, 101.64, " a"], [101.64, 101.8, " red"], [101.8, 102.6, " supergiant"]]}, {"s": 102.6, "e": 105.5, "t": " and starts burning the ashes of its last fire.", "words": [[102.6, 103.12, " and"], [103.12, 103.4, " starts"], [103.4, 103.76, " burning"], [103.76, 104.08, " the"], [104.08, 104.32, " ashes"], [104.32, 104.52, " of"], [104.52, 104.66, " its"], [104.66, 105.06, " last"], [105.06, 105.5, " fire."]]}, {"s": 106.22, "e": 108.16, "t": " Then oxygen. Then silicon.", "words": [[106.12, 106.48, " Then"], [106.48, 106.98, " oxygen."], [107.64, 107.74, " Then"], [107.74, 108.16, " silicon."]]}, {"s": 109.18, "e": 112.08, "t": " Each new fuel buys less time than the one before.", "words": [[109.18, 109.38, " Each"], [109.38, 109.7, " new"], [109.7, 110.04, " fuel"], [110.04, 110.38, " buys"], [110.38, 110.7, " less"], [110.7, 111.1, " time"], [111.1, 111.28, " than"], [111.28, 111.42, " the"], [111.42, 111.56, " one"], [111.56, 112.08, " before."]]}, {"s": 112.96, "e": 116.58, "t": " And when silicon fuses into iron the star hits a dead end.", "words": [[112.96, 113.08, " And"], [113.08, 113.24, " when"], [113.24, 113.68, " silicon"], [113.68, 114.12, " fuses"], [114.12, 114.46, " into"], [114.46, 114.8, " iron"], [114.8, 115.24, " the"], [115.24, 115.58, " star"], [115.58, 115.82, " hits"], [115.82, 116.02, " a"], [116.02, 116.18, " dead"], [116.18, 116.58, " end."]]}, {"s": 117.4, "e": 121.7, "t": " Fusing iron releases no energy so nothing pushes back against gravity.", "words": [[117.4, 117.72, " Fusing"], [117.72, 118.12, " iron"], [118.12, 118.54, " releases"], [118.54, 118.88, " no"], [118.88, 119.3, " energy"], [119.3, 119.78, " so"], [119.78, 120.14, " nothing"], [120.14, 120.48, " pushes"], [120.48, 120.82, " back"], [120.82, 121.22, " against"], [121.22, 121.7, " gravity."]]}, {"s": 122.66, "e": 128.4, "t": " In less than a second the core collapses. It rebounds and a shockwave races outward.", "words": [[122.66, 122.86, " In"], [122.86, 123.02, " less"], [123.02, 123.22, " than"], [123.22, 123.42, " a"], [123.42, 123.7, " second"], [123.7, 124.08, " the"], [124.08, 124.32, " core"], [124.32, 124.94, " collapses."], [125.76, 125.88, " It"], [125.88, 126.38, " rebounds"], [126.38, 126.82, " and"], [126.82, 127.0, " a"], [127.0, 127.44, " shockwave"], [127.44, 127.9, " races"], [127.9, 128.4, " outward."]]}, {"s": 129.36, "e": 134.4, "t": " That is a supernova. One dying star can outshine its entire galaxy.", "words": [[129.36, 129.54, " That"], [129.54, 129.68, " is"], [129.68, 129.92, " a"], [129.92, 130.4, " supernova."], [131.32, 131.64, " One"], [131.64, 132.0, " dying"], [132.0, 132.44, " star"], [132.44, 132.7, " can"], [132.7, 133.16, " outshine"], [133.16, 133.38, " its"], [133.38, 133.84, " entire"], [133.84, 134.4, " galaxy."]]}, {"s": 135.12, "e": 139.34, "t": " We have seen it happen. In the year 1054 Chinese", "words": [[135.1, 135.42, " We"], [135.42, 135.52, " have"], [135.52, 135.74, " seen"], [135.74, 135.92, " it"], [135.92, 136.28, " happen."], [137.1, 137.18, " In"], [137.18, 137.34, " the"], [137.34, 137.56, " year"], [137.56, 138.46, " 1054"], [138.46, 139.34, " Chinese"]]}, {"s": 139.34, "e": 143.48, "t": " astronomers recorded a guest star visible in the daytime sky.", "words": [[139.34, 139.9, " astronomers"], [139.9, 140.5, " recorded"], [140.5, 140.74, " a"], [140.74, 141.0, " guest"], [141.0, 141.52, " star"], [141.52, 142.14, " visible"], [142.14, 142.42, " in"], [142.42, 142.58, " the"], [142.58, 142.9, " daytime"], [142.9, 143.48, " sky."]]}, {"s": 144.44, "e": 148.82, "t": " Today we find the Crab Nebula right there. And here's the twist.", "words": [[144.44, 144.76, " Today"], [144.76, 145.22, " we"], [145.22, 145.5, " find"], [145.5, 145.74, " the"], [145.74, 145.96, " Crab"], [145.96, 146.34, " Nebula"], [146.34, 146.68, " right"], [146.68, 147.26, " there."], [147.9, 148.02, " And"], [148.02, 148.28, " here's"], [148.28, 148.44, " the"], [148.44, 148.82, " twist."]]}, {"s": 149.52, "e": 153.98, "t": " All the oxygen in our solar system came from exploding massive stars.", "words": [[149.52, 149.84, " All"], [149.84, 150.1, " the"], [150.1, 150.48, " oxygen"], [150.48, 150.72, " in"], [150.72, 150.98, " our"], [150.98, 151.16, " solar"], [151.16, 151.6, " system"], [151.6, 152.02, " came"], [152.02, 152.28, " from"], [152.28, 152.86, " exploding"], [152.86, 153.34, " massive"], [153.34, 153.98, " stars."]]}, {"s": 154.88, "e": 158.48, "t": " So did about half the calcium and about 40% of the iron.", "words": [[154.88, 155.06, " So"], [155.06, 155.22, " did"], [155.22, 155.48, " about"], [155.48, 155.76, " half"], [155.76, 156.04, " the"], [156.04, 156.4, " calcium"], [156.4, 156.84, " and"], [156.84, 157.1, " about"], [157.1, 157.48, " 40"], [157.48, 157.8, "%"], [157.8, 158.0, " of"], [158.0, 158.22, " the"], [158.22, 158.48, " iron."]]}, {"s": 159.46, "e": 162.28, "t": " The calcium in your bones came from these explosions.", "words": [[159.46, 159.6, " The"], [159.6, 160.02, " calcium"], [160.02, 160.2, " in"], [160.2, 160.4, " your"], [160.4, 160.78, " bones"], [160.78, 161.18, " came"], [161.18, 161.42, " from"], [161.42, 161.62, " these"], [161.62, 162.28, " explosions."]]}, {"s": 162.84, "e": 168.1, "t": " But what happens to the core? It survives as an incredibly dense remnant.", "words": [[162.84, 163.4, " But"], [163.4, 163.58, " what"], [163.58, 163.98, " happens"], [163.98, 164.2, " to"], [164.2, 164.42, " the"], [164.42, 164.64, " core?"], [165.56, 165.78, " It"], [165.78, 166.26, " survives"], [166.26, 166.48, " as"], [166.48, 166.66, " an"], [166.66, 167.14, " incredibly"], [167.14, 167.56, " dense"], [167.56, 168.1, " remnant."]]}, {"s": 168.96, "e": 172.96, "t": " Below a limit it becomes a neutron star about the size of a city.", "words": [[168.96, 169.16, " Below"], [169.16, 169.38, " a"], [169.38, 169.62, " limit"], [169.62, 169.96, " it"], [169.96, 170.32, " becomes"], [170.32, 170.54, " a"], [170.54, 170.88, " neutron"], [170.88, 171.46, " star"], [171.46, 171.88, " about"], [171.88, 172.16, " the"], [172.16, 172.36, " size"], [172.36, 172.5, " of"], [172.5, 172.66, " a"], [172.66, 172.96, " city."]]}, {"s": 173.68, "e": 177.0, "t": " But if the star was heavy enough nothing can stop the collapse.", "words": [[173.68, 173.82, " But"], [173.82, 173.96, " if"], [173.96, 174.14, " the"], [174.14, 174.38, " star"], [174.38, 174.58, " was"], [174.58, 174.82, " heavy"], [174.82, 175.2, " enough"], [175.2, 175.76, " nothing"], [175.76, 176.04, " can"], [176.04, 176.34, " stop"], [176.34, 176.54, " the"], [176.54, 177.0, " collapse."]]}, {"s": 177.82, "e": 181.94, "t": " The core falls until gravity is so strong that not even light escapes.", "words": [[177.82, 177.94, " The"], [177.94, 178.2, " core"], [178.2, 178.62, " falls"], [178.62, 178.94, " until"], [178.94, 179.38, " gravity"], [179.38, 179.62, " is"], [179.62, 179.8, " so"], [179.8, 180.26, " strong"], [180.26, 180.64, " that"], [180.64, 180.78, " not"], [180.78, 181.06, " even"], [181.06, 181.38, " light"], [181.38, 181.94, " escapes."]]}, {"s": 182.8, "e": 186.86, "t": " That boundary is the event horizon. A black hole is born.", "words": [[182.8, 183.02, " That"], [183.02, 183.44, " boundary"], [183.44, 183.7, " is"], [183.7, 183.88, " the"], [183.88, 184.16, " event"], [184.16, 184.68, " horizon."], [185.42, 185.64, " A"], [185.64, 185.9, " black"], [185.9, 186.18, " hole"], [186.18, 186.46, " is"], [186.46, 186.86, " born."]]}, {"s": 187.7, "e": 192.16, "t": " This is the first image of a black hole's shadow from the event horizon telescope.", "words": [[187.7, 187.9, " This"], [187.9, 188.04, " is"], [188.04, 188.18, " the"], [188.18, 188.46, " first"], [188.46, 188.8, " image"], [188.8, 188.96, " of"], [188.96, 189.16, " a"], [189.16, 189.34, " black"], [189.34, 189.78, " hole's"], [189.78, 190.08, " shadow"], [190.08, 190.5, " from"], [190.5, 190.7, " the"], [190.7, 190.96, " event"], [190.96, 191.52, " horizon"], [191.52, 192.16, " telescope."]]}, {"s": 192.74, "e": 197.2, "t": " That one is a giant six and a half billion times the mass of the sun.", "words": [[192.74, 193.28, " That"], [193.28, 193.54, " one"], [193.54, 193.68, " is"], [193.68, 193.92, " a"], [193.92, 194.26, " giant"], [194.26, 194.72, " six"], [194.72, 194.86, " and"], [194.86, 195.08, " a"], [195.08, 195.22, " half"], [195.22, 195.6, " billion"], [195.6, 196.12, " times"], [196.12, 196.32, " the"], [196.32, 196.52, " mass"], [196.52, 196.72, " of"], [196.72, 196.92, " the"], [196.92, 197.2, " sun."]]}, {"s": 198.2, "e": 201.12, "t": " Black holes left by dying stars are far smaller.", "words": [[198.2, 198.4, " Black"], [198.4, 198.72, " holes"], [198.72, 199.04, " left"], [199.04, 199.34, " by"], [199.34, 199.68, " dying"], [199.68, 200.16, " stars"], [200.16, 200.42, " are"], [200.42, 200.62, " far"], [200.62, 201.12, " smaller."]]}, {"s": 201.94, "e": 204.94, "t": " So if light can't escape how do we know they're there?", "words": [[201.94, 202.12, " So"], [202.12, 202.3, " if"], [202.3, 202.56, " light"], [202.56, 202.92, " can't"], [202.92, 203.32, " escape"], [203.32, 203.76, " how"], [203.76, 203.88, " do"], [203.88, 203.98, " we"], [203.98, 204.22, " know"], [204.22, 204.46, " they're"], [204.46, 204.94, " there?"]]}, {"s": 205.62, "e": 209.82, "t": " Because they pull on their neighbors. Many are paired with a living star", "words": [[205.62, 205.84, " Because"], [205.84, 206.08, " they"], [206.0